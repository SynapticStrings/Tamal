{
  "format": 1,
  "scenarios": [
    {
      "name": "G-INT-03/tempo_change_uniform_scale",
      "note": "a pure tempo change enters the log as retime batches of the affected elements; the warp comes from the caller's tempo map",
      "space": [1, 2],
      "script": [
        [
          {"op": "retime", "id": 1, "old_span": [0, 10], "new_span": [0, 5]},
          {"op": "retime", "id": 2, "old_span": [10, 20], "new_span": [5, 10]}
        ]
      ],
      "warps": [
        {"coord": "seconds", "entry": 1,
         "segments": [{"old": [0, 20], "new": [0, 10]}]}
      ],
      "cases": [
        {
          "anchor": {"type": "metric", "coord": "seconds", "from": 4, "to": 12},
          "expect": {"status": "ok", "anchor": {"type": "metric", "coord": "seconds", "from": 2, "to": 6, "at_version": 1}}
        }
      ]
    },
    {
      "name": "G-INT-05/seconds_anchor_survives_tempo_change",
      "note": "SEMANTIC FLIP vs zongzi (docs/decisions/0003): zongzi conflicts here (snapshot_stale); tamale survives structurally and defers the semantic verdict to Patch.resolve",
      "space": [1, 2],
      "script": [
        [
          {"op": "retime", "id": 1, "old_span": [0, 10], "new_span": [0, 5]},
          {"op": "retime", "id": 2, "old_span": [10, 20], "new_span": [5, 10]}
        ]
      ],
      "warps": [
        {"coord": "seconds", "entry": 1,
         "segments": [{"old": [0, 20], "new": [0, 10]}]}
      ],
      "cases": [
        {
          "anchor": {"type": "metric", "coord": "seconds", "from": 1, "to": 3},
          "expect": {"status": "ok", "anchor": {"type": "metric", "coord": "seconds", "from": "1/2", "to": "3/2", "at_version": 1}}
        }
      ]
    },
    {
      "name": "deleted_region_clips_and_drops",
      "note": "G-PRE family: partial survival is first-class; covered anchors are new-coordinate images, lost sub-intervals are old-coordinate. Measure-zero coverage does not count",
      "space": [1, 2],
      "script": [
        [{"op": "retime", "id": 1, "old_span": [0, 30], "new_span": [0, 15]}]
      ],
      "warps": [
        {"coord": "seconds", "entry": 1,
         "segments": [
           {"old": [0, 10], "new": [0, 5]},
           {"old": [20, 30], "new": [10, 15]}
         ]}
      ],
      "cases": [
        {
          "name": "straddling the deleted region",
          "anchor": {"type": "metric", "coord": "seconds", "from": 5, "to": 25},
          "expect": {
            "status": "clip",
            "covered": [
              {"type": "metric", "coord": "seconds", "from": "5/2", "to": 5, "at_version": 1},
              {"type": "metric", "coord": "seconds", "from": 10, "to": "25/2", "at_version": 1}
            ],
            "lost": [[10, 20]]
          }
        },
        {
          "name": "entirely inside the deleted region",
          "anchor": {"type": "metric", "coord": "seconds", "from": 12, "to": 18},
          "expect": {"status": "undefined", "reason": "outside_warp"}
        }
      ]
    },
    {
      "name": "insertion_stretches_anchor",
      "note": "a jump in the warp (new material inserted) grows the anchor to enclose it; what happens to the payload is ChannelAdapter.warp_payload's call",
      "space": [1],
      "script": [
        [{"op": "retime", "id": 1, "old_span": [0, 20], "new_span": [0, 30]}]
      ],
      "warps": [
        {"coord": "tick", "entry": 1,
         "segments": [
           {"old": [0, 10], "new": [0, 10]},
           {"old": [10, 20], "new": [20, 30]}
         ]}
      ],
      "cases": [
        {
          "anchor": {"type": "metric", "coord": "tick", "from": 5, "to": 15},
          "expect": {"status": "ok", "anchor": {"type": "metric", "coord": "tick", "from": 5, "to": 25, "at_version": 1}}
        }
      ]
    },
    {
      "name": "identity_when_no_warp_listed",
      "note": "entries without a listed warp default to identity — most ops do not move coordinates",
      "space": [1],
      "script": [
        [{"op": "insert", "id": 2, "after_id": 1}]
      ],
      "cases": [
        {
          "anchor": {"type": "metric", "coord": "tick", "from": 0, "to": 10},
          "expect": {"status": "ok", "anchor": {"type": "metric", "coord": "tick", "from": 0, "to": 10, "at_version": 1}}
        }
      ]
    },
    {
      "name": "multi_entry_folds_oldest_first",
      "note": "entry 1 scales by 1/2, entry 2 translates by +100; the fold applies them chronologically",
      "space": [1, 2],
      "script": [
        [{"op": "retime", "id": 1, "old_span": [0, 10], "new_span": [0, 5]}],
        [{"op": "retime", "id": 2, "old_span": [10, 20], "new_span": [110, 120]}]
      ],
      "warps": [
        {"coord": "tick", "entry": 1,
         "segments": [{"old": [0, 100], "new": [0, 50]}]},
        {"coord": "tick", "entry": 2,
         "segments": [{"old": [0, 50], "new": [100, 150]}]}
      ],
      "cases": [
        {
          "anchor": {"type": "metric", "coord": "tick", "from": 4, "to": 12},
          "expect": {"status": "ok", "anchor": {"type": "metric", "coord": "tick", "from": 102, "to": 106, "at_version": 2}}
        }
      ]
    },
    {
      "name": "fractional_rates_are_exact",
      "note": "docs/decisions/0007: coordinates are exact rationals — a 1/3 tempo produces thirds, never float dust; p/q strings are first-class on the wire",
      "space": [1],
      "script": [
        [{"op": "retime", "id": 1, "old_span": [0, 3], "new_span": [0, 1]}]
      ],
      "warps": [
        {"coord": "seconds", "entry": 1,
         "segments": [{"old": [0, 3], "new": [0, 1]}]}
      ],
      "cases": [
        {
          "name": "integer endpoints become thirds",
          "anchor": {"type": "metric", "coord": "seconds", "from": 1, "to": 2},
          "expect": {"status": "ok", "anchor": {"type": "metric", "coord": "seconds", "from": "1/3", "to": "2/3", "at_version": 1}}
        },
        {
          "name": "rational endpoints stay exact",
          "anchor": {"type": "metric", "coord": "seconds", "from": "1/2", "to": 1},
          "expect": {"status": "ok", "anchor": {"type": "metric", "coord": "seconds", "from": "1/6", "to": "1/3", "at_version": 1}}
        }
      ]
    },
    {
      "name": "fractional_compose_is_exact",
      "note": "composing a 1/2 scale with a 1/3 scale yields exactly 1/6 — the fold accumulates no rounding across entries",
      "space": [1],
      "script": [
        [{"op": "retime", "id": 1, "old_span": [0, 12], "new_span": [0, 6]}],
        [{"op": "retime", "id": 1, "old_span": [0, 6], "new_span": [0, 2]}]
      ],
      "warps": [
        {"coord": "tick", "entry": 1,
         "segments": [{"old": [0, 12], "new": [0, 6]}]},
        {"coord": "tick", "entry": 2,
         "segments": [{"old": [0, 6], "new": [0, 2]}]}
      ],
      "cases": [
        {
          "anchor": {"type": "metric", "coord": "tick", "from": 2, "to": 4},
          "expect": {"status": "ok", "anchor": {"type": "metric", "coord": "tick", "from": "1/3", "to": "2/3", "at_version": 2}}
        }
      ]
    },
    {
      "name": "interval_starting_at_jump_uses_arriving_piece",
      "note": "an anchor whose from lands exactly on an insertion-jump boundary takes its image from the arriving piece — the departing piece contributes only measure-zero contact, which does not count as coverage (contrast insertion_stretches_anchor, where the jump is strictly inside)",
      "space": [1],
      "script": [
        [{"op": "retime", "id": 1, "old_span": [0, 20], "new_span": [0, 40]}]
      ],
      "warps": [
        {"coord": "tick", "entry": 1,
         "segments": [
           {"old": [0, 10], "new": [0, 10]},
           {"old": [10, 20], "new": [30, 40]}
         ]}
      ],
      "cases": [
        {
          "name": "from at the boundary",
          "anchor": {"type": "metric", "coord": "tick", "from": 10, "to": 15},
          "expect": {"status": "ok", "anchor": {"type": "metric", "coord": "tick", "from": 30, "to": 35, "at_version": 1}}
        },
        {
          "name": "to at the boundary still belongs to the departing piece",
          "anchor": {"type": "metric", "coord": "tick", "from": 5, "to": 10},
          "expect": {"status": "ok", "anchor": {"type": "metric", "coord": "tick", "from": 5, "to": 10, "at_version": 1}}
        },
        {
          "name": "point at the boundary resolves to the first piece",
          "anchor": {"type": "metric", "coord": "tick", "from": 10, "to": 10},
          "expect": {"status": "ok", "anchor": {"type": "metric", "coord": "tick", "from": 10, "to": 10, "at_version": 1}}
        }
      ]
    },
    {
      "name": "clip_fragment_starting_at_jump_uses_arriving_piece",
      "note": "the covered image starts at 30, not 10: [10, 30) has no preimage in the anchor's support",
      "space": [1],
      "script": [
        [{"op": "retime", "id": 1, "old_span": [0, 15], "new_span": [0, 35]}]
      ],
      "warps": [
        {"coord": "tick", "entry": 1,
         "segments": [
           {"old": [0, 10], "new": [0, 10]},
           {"old": [10, 15], "new": [30, 35]}
         ]}
      ],
      "cases": [
        {
          "anchor": {"type": "metric", "coord": "tick", "from": 10, "to": 20},
          "expect": {
            "status": "clip",
            "covered": [
              {"type": "metric", "coord": "tick", "from": 30, "to": 35, "at_version": 1}
            ],
            "lost": [[15, 20]]
          }
        }
      ]
    }
  ]
}
